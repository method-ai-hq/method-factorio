{
  "format": "method/3",
  "name": "p19-observed-fuel",
  "goal": "Build a self-running iron production chain within the fixed supplied-kit benchmark.",
  "environment": {
    "game": {
      "type": "service",
      "description": "Restricted game action endpoint."
    }
  },
  "steps": {
    "build": {
      "purpose": "Final states on all p17 maps consumed three drill coal, two furnace coal, and one inserter coal. Test those observed quantities instead of 130 loaded coal. This tests material reserve, not a change to the ranking.",
      "in": {
        "endpoint": "environment.game"
      },
      "do": {
        "kind": "run",
        "runtime": "python",
        "entrypoint": "controller.py",
        "args": []
      },
      "out": {
        "report": {
          "type": "text",
          "description": "Observed attempts and final controller result."
        }
      },
      "changes": [
        "environment.game"
      ],
      "check": {
        "present": "report"
      },
      "limits": {
        "timeout_ms": 200000
      }
    }
  },
  "result": "report",
  "files": [
    "controller.py"
  ]
}
