{
  "format": "method/3",
  "name": "p15-place-before-move",
  "goal": "Build a self-running iron production chain within the fixed supplied-kit benchmark.",
  "environment": {
    "game": {
      "type": "service",
      "description": "Restricted game action endpoint."
    }
  },
  "steps": {
    "build": {
      "purpose": "Attempt allowed drill placement before explicit movement. On failure, observe first, reuse an existing drill if present, otherwise move and retry once. Expect less movement if placement already handles reach.",
      "in": {
        "endpoint": "environment.game"
      },
      "do": {
        "kind": "run",
        "runtime": "python",
        "entrypoint": "controller.py",
        "args": []
      },
      "out": {
        "report": {
          "type": "text",
          "description": "Observed attempts and final controller result."
        }
      },
      "changes": [
        "environment.game"
      ],
      "check": {
        "present": "report"
      },
      "limits": {
        "timeout_ms": 200000
      }
    }
  },
  "result": "report",
  "files": [
    "controller.py"
  ]
}
