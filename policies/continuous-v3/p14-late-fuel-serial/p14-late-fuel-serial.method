{
  "format": "method/3",
  "name": "p14-late-fuel-serial",
  "goal": "Build a self-running iron production chain within the fixed supplied-kit benchmark.",
  "environment": {
    "game": {
      "type": "service",
      "description": "Restricted game action endpoint."
    }
  },
  "steps": {
    "build": {
      "purpose": "Replace the rejected batch action with three allowed inserts. Fuel the drill last so the route is ready before mining. Stop on an unsupported action instead of rebuilding all four directions.",
      "in": {
        "endpoint": "environment.game"
      },
      "do": {
        "kind": "run",
        "runtime": "python",
        "entrypoint": "controller.py",
        "args": []
      },
      "out": {
        "report": {
          "type": "text",
          "description": "Observed attempts and final controller result."
        }
      },
      "changes": [
        "environment.game"
      ],
      "check": {
        "present": "report"
      },
      "limits": {
        "timeout_ms": 200000
      }
    }
  },
  "result": "report",
  "files": [
    "controller.py"
  ]
}
